# On-Ground.ai Frontend Configuration
# Vapi Web SDK Credentials for In-Browser WebRTC calling
# Get your Public Key from Vapi Dashboard -> Org Settings -> API Keys -> Public Key
VITE_VAPI_PUBLIC_KEY=your_vapi_public_key_here

# Assistant ID for In-Browser WebRTC voice calls
VITE_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Backend API Base URL (defaults to /api via Vite reverse proxy)
VITE_API_BASE_URL=http://localhost:8000/api
